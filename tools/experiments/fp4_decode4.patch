+__device__ __forceinline__ void decode_e2m1x4(
+    uint16_t packed, float &x0, float &x1, float &x2, float &x3) {
+    uint32_t lo, hi;
+    asm volatile(
+        "{ .reg .b8 b0,b1,b2,b3;\n\t"
+        "mov.b32 {b0,b1,b2,b3}, %2;\n\t"
+        "cvt.rn.f16x2.e2m1x2 %0, b0;\n\t"
+        "cvt.rn.f16x2.e2m1x2 %1, b1; }"
+        : "=r"(lo), "=r"(hi) : "r"(static_cast<uint32_t>(packed)));
+    const __half2_raw a{static_cast<uint16_t>(lo), static_cast<uint16_t>(lo >> 16)};
+    const __half2_raw b{static_cast<uint16_t>(hi), static_cast<uint16_t>(hi >> 16)};
+    const float2 af = __half22float2(static_cast<__half2>(a));
+    const float2 bf = __half22float2(static_cast<__half2>(b));
+    x0 = af.x; x1 = af.y; x2 = bf.x; x3 = bf.y;
+}
